
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- SECURITY: HOTLINK PROTECTION ---
  # Mencegah website lain mencuri bandwidth (Hotlinking) gambar & video Anda.
  # Ganti domain di bawah sesuai domain asli saat production.
  
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?localhost [NC]
  RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?127.0.0.1 [NC]
  # Tambahkan domain production anda di baris bawah ini:
  RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?unair.ac.id [NC]
  RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?ppk2ipe.unair.ac.id [NC]
  RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?google.com [NC]
  # Blokir akses langsung ke file ekstensi berikut jika bukan dari domain di atas
  RewriteRule \.(mp4|avi|mov|wmv|jpg|jpeg|png|gif|svg)$ - [NC,F,L]
  # ------------------------------------

  # 1. Handle React Router (Single Page Application)
  # Jika file yang diminta BUKAN file fisik (!-f)
  RewriteCond %{REQUEST_FILENAME} !-f
  # Dan BUKAN folder fisik (!-d)
  RewriteCond %{REQUEST_FILENAME} !-d
  # Maka arahkan semua request ke index.html
  RewriteRule ^ index.html [L]
</IfModule>

# 2. Security: Matikan akses browsing folder
Options -Indexes

# 3. Performance: Aktifkan Kompresi Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 4. Caching Headers (Optimal untuk React Production Build)
<IfModule mod_headers.c>
  # File HTML jangan dicache (agar update aplikasi langsung terlihat user)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </FilesMatch>

  # Aset Statis (JS, CSS, Gambar) cache selama 1 tahun
  # (Asumsi build tool seperti Vite/Webpack menggunakan hashing pada nama file)
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>
